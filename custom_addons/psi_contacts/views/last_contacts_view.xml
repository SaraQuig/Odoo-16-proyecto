<odoo>
    <record id="view_last_contacts_tree" model="ir.ui.view">
        <field name="name">Últimos Contactos</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Últimos 3 Contactos" create="false" delete="false">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="action_last_contacts" model="ir.actions.act_window">
        <field name="name">Últimos Contactos</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree</field>
        <field name="domain">[]</field>
        <field name="context">{'default_limit': 3}</field>
    </record>

    <menuitem id="menu_last_contacts"
              name="Últimos Contactos"
              parent="contacts.menu_contacts"
              action="action_last_contacts"/>
</odoo>
